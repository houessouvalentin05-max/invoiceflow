# ─────────────────────────────────────────────────────────────
# InvoiceFlow — Variables d'environnement requises
# Copiez ce fichier vers `.env.local` et remplissez les valeurs.
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# URL de votre projet Supabase (PAS de slash final).
# Ex. https://abcdefghijklmn.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé "anon" publique de votre projet Supabase (sans danger côté navigateur).
# Disponible dans Supabase → Settings → API. Ne JAMAIS mettre de clé service_role ici.
NEXT_PUBLIC_SUPABASE_ANON_KEY=